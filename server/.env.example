# Supabase/PostgreSQL connection string from Supabase Dashboard > Connect
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
DATABASE_SSL=true
DB_POOL_SIZE=1

# Local frontend URL; for Vercel use your production frontend URL.
CLIENT_URL=http://localhost:5173

# Generate a long random value for production.
JWT_SECRET=replace-with-a-long-random-secret

# Used once to create the restaurant admin account.
ADMIN_EMAIL=example@gmail.com

ADMIN_PASSWORD=ChangeMe123!

PORT=5000
